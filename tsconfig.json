{
  "compilerOptions": {
    "target": "es2016",
    "module": "es2020",
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./dist",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2024"],
    "baseUrl": ".",
    "paths": {
        "@/linters/*": ["./src/ace-linters/src/*"]
    }
  },
  "exclude": ["./dist/**/*"],
}